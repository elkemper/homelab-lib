# Server Environment Variables

# Port for the server to listen on
PORT=3214

# Path to the SQLite database file
# Example: ./db.sqlite or /path/to/your/database.sqlite
DB_PATH=

# Path to the directory with archives
# Example: /app/data/archive
ARCHIVE_PATH=

# Secret key for JSON Web Token (JWT) generation
# Make sure this is a strong, random string in production
JWT_SECRET=your_jwt_secret_key

# Default admin username (bootstrapped as user id=0 on every start)
ADMIN_USERNAME=

# Default admin password (re-applied to the admin user on every start)
ADMIN_PASSWORD=

# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000, https://yourdomain.com
# NOTE: currently unused, the server sends Access-Control-Allow-Origin: *
ALLOWED_ORIGINS=http://localhost:3000

# Maximum number of requests allowed per 10-second window, per IP
REQUEST_RATE_LIMIT=20
